# Reading this site makes no third-party request: one stylesheet, the fonts
# and two scripts, all from this origin. The CSP says so, so that a future
# edit that adds one fails loudly instead of quietly shipping.
#
# The one inline script is the chrome's pre-paint theme script
# (`@optersoft/astro`, THEME_APPLY_SCRIPT), allowed by its hash — it has to be
# inline, or the page flashes the wrong colour scheme. Recompute the hash when
# that script changes:
#   perl -0ne 'print $1 if /<script>(\(function.*?\)\(\);)<\/script>/s' dist/index.html | openssl dgst -sha256 -binary | base64
/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; script-src 'self' 'sha256-yJaicz1qy7qVh0qTL53mGbCrLL/zJIY5XRDzyv4uc/A='; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=86400
