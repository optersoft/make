---
// One band of the page: an anchor, an h2, then its content. Alternating
// surfaces, the way optersoft.com's bands do.
interface Props {
  id: string;
  heading: string;
  alt?: boolean;
}
const { id, heading, alt = false } = Astro.props;
const cls = alt
  ? "scroll-mt-20 bg-slate-50 dark:bg-slate-900/40"
  : "scroll-mt-20 border-t border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-950";
---

<section id={id} class={cls}>
  <div class="container mx-auto px-5 sm:px-6 py-14 sm:py-16 max-w-6xl">
    <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-balance text-slate-900 dark:text-white">{heading}</h2>
    <div class="prose-mk mt-5 text-slate-600 leading-relaxed dark:text-slate-300">
      <slot />
    </div>
  </div>
</section>
