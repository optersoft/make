---
// `dist/404.html` — Cloudflare Pages serves it, with a 404 status, for any
// unmatched path.
import Site from "../layouts/Site.astro";
import NotFound from "@optersoft/astro/NotFound.astro";
---

<Site title="Not found — mkrun" description="No such page on make.optersoft.com." noindex={true}>
  <NotFound
    heading="No such page"
    body="There is one page here, and this is not it."
    home={{ href: "/", label: "Back to mkrun" }}
    other={{ href: "https://academy.optersoft.com/project/make", label: "The tutorial" }}
  />
</Site>
