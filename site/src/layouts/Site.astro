---
// Every page of make.optersoft.com: the chrome's Layout + Shell with this
// site's brand and links. The footer is the chrome's default — the company.
import Layout from "@optersoft/astro/Layout.astro";
import Shell from "@optersoft/astro/Shell.astro";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
}
const { title, description, canonical, noindex } = Astro.props;

const header = {
  brand: { href: "/", name: "mk", suffix: "_" },
  links: [
    { href: "/#what", label: "What it is" },
    { href: "/#worth", label: "Why" },
    { href: "/#start", label: "Get started" },
    { href: "https://academy.optersoft.com/project/make", label: "Tutorial" },
    { href: "https://github.com/optersoft/make", label: "GitHub" },
  ],
};
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  noindex={noindex}
  site="mkrun"
  icons={[{ href: "/favicon.svg", type: "image/svg+xml" }]}
>
  <Shell header={header}>
    <slot />
  </Shell>
</Layout>
